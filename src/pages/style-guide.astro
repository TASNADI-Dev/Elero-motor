---
// Internal style guide: lists every theme color and reusable component. Noindex, not linked anywhere.
import "../styles/global.css";
import Button from "../components/Button.astro";
import css from "../styles/global.css?raw";

const colors = [...css.matchAll(/--color-([a-z0-9-]+):\s*([^;]+);/g)]
	.filter(([, name]) => name !== "*")
	.map(([, name, value]) => ({ name, value: value.trim() }));
const baseColors = colors.filter((color) => !color.value.startsWith("var("));
const semanticColors = colors.filter((color) => color.value.startsWith("var("));
const groups = [
	{ title: "Base colors", colors: baseColors },
	{ title: "Semantic colors", colors: semanticColors },
].filter((group) => group.colors.length > 0);

const buttonVariants = [
	{ title: "Primary", variant: "primary" },
	{ title: "Secondary", variant: "secondary" },
] as const;
const buttonSizes = ["large", "small"] as const;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/global/favicon.svg" />
		<title>Style guide</title>
	</head>
	<body class="font-sans">
		<main class="mx-auto w-full max-w-content px-4 py-12">
			<section>
				<h2 class="font-heading text-3xl">Colors</h2>
				{
					groups.map((group) => (
						<div class="mt-8">
							<h3 class="font-heading text-xl">{group.title}</h3>
							<ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
								{group.colors.map((color) => (
									<li>
										<div
											class="h-20 rounded-lg border"
											style={`background-color: var(--color-${color.name})`}
										/>
										<p class="mt-2 text-sm">{color.name}</p>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</section>
			<section class="mt-16">
				<h2 class="font-heading text-3xl">Button</h2>
				<ul class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
					{
						buttonVariants.flatMap(({ title, variant }) =>
							buttonSizes.map((size) => (
								<li>
									<Button variant={variant} size={size}>
										Megnézem
									</Button>
									<p class="mt-2 text-sm capitalize">
										{title} / {size}
									</p>
								</li>
							)),
						)
					}
				</ul>
			</section>
		</main>
	</body>
</html>
